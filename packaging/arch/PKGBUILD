# Maintainer: hyperdreamer
#
# Qt 6 / QtWebEngine build of GoldenDict for Arch Linux.
#
#   makepkg -si
#
# The source follows master, so a plain `makepkg -si` builds the newest code.
# The qmake project installs into $PREFIX (default /usr/local), so PREFIX=/usr is
# passed at configure time and the binary looks for its data in /usr/share/goldendict.
#
# Building a specific revision instead of master (reproducible rebuilds):
#   GD_TAG=1.5.5 makepkg -si      build that release tag
#   GD_COMMIT=<sha> makepkg -si   build that exact commit
# pkgver() is always derived from git describe, so the package version records
# the tag, the distance from it, and the commit hash of whatever was built.
# The pkgver= line is therefore informational only: keep it at the last release
# tag and do not commit a build's pkgver() output here, which is stale as soon
# as one more commit lands.

pkgname=goldendict
pkgver=1.5.5
pkgrel=1
epoch=2
pkgdesc='Feature-rich dictionary lookup program (Qt 6 and QtWebEngine)'
arch=('x86_64' 'aarch64')
url='https://github.com/hyperdreamer/goldendict'
license=('GPL-3.0-or-later')
if [[ -n ${GD_COMMIT:-} ]]; then
  # Exact commit: reproducible rebuild of anything ever built.
  source=("${pkgname}::git+https://github.com/hyperdreamer/goldendict.git#commit=${GD_COMMIT}")
elif [[ -n ${GD_TAG:-} ]]; then
  # A tagged release.
  source=("${pkgname}::git+https://github.com/hyperdreamer/goldendict.git#tag=${GD_TAG}")
else
  # Default: the newest commit on master.
  source=("${pkgname}::git+https://github.com/hyperdreamer/goldendict.git#branch=master")
fi
sha256sums=('SKIP')

depends=(
  # Qt 6 modules the application links: core gui widgets xml network sql
  # printsupport help svg webenginecore webenginewidgets webchannel dbus pdf pdfwidgets
  qt6-base
  qt6-webengine          # also ships QtPdf and QtPdfWidgets
  qt6-svg
  qt6-tools              # QtHelp
  qt6-webchannel
  kwindowsystem          # optional best-effort window activation, detected at configure time
  # Optional features this package turns on at configure time
  opencc                 # CONFIG+=chinese_conversion_support
  xz                     # zim_support: liblzma
  zstd                   # zim_support: libzstd
  # Everything else comes from the compiled link line
  libeb
  hunspell
  lzo
  libtiff
  libao
  ffmpeg
  libx11
  libxtst
  zlib
  bzip2
  libvorbis
)
makedepends=('git' 'qt6-tools')
conflicts=('goldendict-git' 'goldendict-ng' 'goldendict-ng-git')
provides=('goldendict')
options=('!lto' '!debug')

pkgver() {
  cd "${pkgname}"
  # Tag, distance from it, and hash of the checkout actually built:
  # 1.5.4.r0.gc9a20f82 on the release tag, 1.5.4.r1.gbaef2345 one commit past it.
  # --dirty is deliberately omitted: makepkg's working copy is clean, and a stray
  # marker would silently change the package version.
  git describe --long --tags --abbrev=8 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "${pkgname}"
  # Build in the source tree: two translation units carry a Q_OBJECT class in the
  # .cc and include their own generated .moc, which qmake cannot satisfy from a
  # build directory outside the source tree.
  qmake6 goldendict.pro PREFIX=/usr \
    CONFIG+=chinese_conversion_support \
    CONFIG+=zim_support
  make -j"$(nproc)"
}

package() {
  cd "${pkgname}"
  make INSTALL_ROOT="${pkgdir}" install

  install -Dm644 LICENSE.txt "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.txt"
}
