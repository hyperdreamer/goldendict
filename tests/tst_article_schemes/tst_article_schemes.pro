TARGET = tst_article_schemes
include(../testsupport.pri)

# Exercise the production resource coordinator and a real Chromium document.
QT += core gui widgets xml webenginecore webenginewidgets

SOURCES += $$GD_REPO_ROOT/articleurls.cc \
           $$GD_REPO_ROOT/articleschemes.cc \
           $$GD_REPO_ROOT/article_netmgr.cc \
           $$GD_REPO_ROOT/article_maker.cc \
           $$GD_REPO_ROOT/config.cc \
           $$GD_REPO_ROOT/dictionary.cc \
           $$GD_REPO_ROOT/folding.cc \
           $$GD_REPO_ROOT/fsencoding.cc \
           $$GD_REPO_ROOT/gddebug.cc \
           $$GD_REPO_ROOT/htmlescape.cc \
           $$GD_REPO_ROOT/instances.cc \
           $$GD_REPO_ROOT/langcoder.cc \
           $$GD_REPO_ROOT/mutex.cc \
           $$GD_REPO_ROOT/utf8.cc \
           $$GD_REPO_ROOT/wildcard.cc \
           $$GD_REPO_ROOT/wstring.cc \
           $$GD_REPO_ROOT/wordfinder.cc \
           $$GD_REPO_ROOT/wstring_qt.cc \
           tst_article_schemes.cc

HEADERS += $$GD_REPO_ROOT/articleurls.hh \
           $$GD_REPO_ROOT/articleschemes.hh \
           $$GD_REPO_ROOT/article_netmgr.hh \
           $$GD_REPO_ROOT/article_maker.hh \
           $$GD_REPO_ROOT/dictionary.hh \
           $$GD_REPO_ROOT/wordfinder.hh

# Bundle the actual shipped article assets. The application-wide qrc also
# requires version.txt generated by the unconverted root project; build this
# equivalent article subset in the ignored output directory instead.
GD_ARTICLE_RESOURCE_DIR = $$OUT_PWD/build/tests/$$TARGET/rcc
mkpath($$GD_ARTICLE_RESOURCE_DIR)
GD_ARTICLE_QRC = $$GD_ARTICLE_RESOURCE_DIR/article-resources.qrc
GD_ARTICLE_RESOURCE_XML = <RCC> <qresource>
GD_ARTICLE_ASSETS = $$files($$GD_REPO_ROOT/article-style*.css) \
                    $$files($$GD_REPO_ROOT/icons/*.png) \
                    $$files($$GD_REPO_ROOT/flags/*.png)
for(GD_ARTICLE_ASSET, GD_ARTICLE_ASSETS) {
    GD_ARTICLE_ALIAS = $$relative_path($$GD_ARTICLE_ASSET, $$GD_REPO_ROOT)
    GD_ARTICLE_RESOURCE_XML += <file alias=\"$$GD_ARTICLE_ALIAS\">$$GD_ARTICLE_ASSET</file>
}
GD_ARTICLE_RESOURCE_XML += </qresource> </RCC>
write_file($$GD_ARTICLE_QRC, GD_ARTICLE_RESOURCE_XML)
RESOURCES += $$GD_ARTICLE_QRC

# dictionary.cc's unrelated ZipFile index timestamp path has not switched yet.
unix {
    QMAKE_CXXFLAGS += -ffunction-sections -fdata-sections
    QMAKE_LFLAGS += -Wl,--gc-sections
}
