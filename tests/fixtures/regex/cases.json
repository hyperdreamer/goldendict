      "pattern": "(<\\s*(?:img|script)\\s(?:[^>]*\\s)?src\\s*=)(?!\\s*[\"']?(?:data|https?|ftp):)(\\s*[\"']?)",
      "newOptions": ["CaseInsensitive"],
      "migration": "unchanged lookahead; the row pins that a data: target produces no match",
      "subject": "<img src=\"data:image/png;base64,AAAA\">",
      "expectedMatchCount": 0
