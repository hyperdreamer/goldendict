      "newOptions": ["CaseInsensitive", "DotMatchesEverything", "InvertedGreediness"],
      "migration": "fixture-pinned direct translation: InvertedGreedinessOption retained so both quantified captures stay minimal",
      "subject": "<audio src=\"a.wav\">x</audio>\n<audio src=\"b.wav\">y</audio>",
