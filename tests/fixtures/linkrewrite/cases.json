{
  "notes": [
    "Fixed expected values for the four LinkRewrite rules. Every row is an authored oracle: no expected value is produced by the implementation under test.",
    "Rows are grouped by production entry point. 'twice: true' means the row is also an idempotence pin: applying the same rule to its own output must reproduce that output byte for byte.",
    "The 'engineSeam' rows pin what the common pass must leave alone after a retained format-specific engine (StarDict, DICT, Zim) composes a lookup URL: the path headword is the only component LinkRewrite::applyGdLookup normalizes.",
    "Whitespace inside an attribute value or a CSS url() is preserved by span-only edits; a target is trimmed only to classify it, never to re-indent the surrounding markup."
  ],

  "gdLookup": [
    {
      "id": "entity-nbsp-headword",
      "input": "<a href=\"gdlookup://localhost/red&nbsp;fox\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/red%20fox\">x</a>",
      "twice": true
    },
    {
      "id": "anchor-query-preserved",
      "input": "<a href=\"gdlookup://localhost/cat?gdanchor=part\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/cat?gdanchor=part\">x</a>",
      "twice": true
    },
    {
      "id": "dict-query-and-fragment-preserved",
      "input": "<a href=\"gdlookup://localhost/cat?dict=Known%20Name&gdanchor=part#frag\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/cat?dict=Known%20Name&gdanchor=part#frag\">x</a>",
      "twice": true
    },
    {
      "id": "percent-encoded-path-not-double-encoded",
      "input": "<a href=\"gdlookup://localhost/red%20fox\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/red%20fox\">x</a>",
      "twice": true
    },
    {
      "id": "percent-sign-not-double-encoded",
      "input": "<a href=\"gdlookup://localhost/100%25\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/100%25\">x</a>",
      "twice": true
    },
    {
      "id": "raw-space-encoded-once",
      "input": "<a href=\"gdlookup://localhost/red fox\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/red%20fox\">x</a>",
      "twice": true
    },
    {
      "id": "unicode-headword",
      "input": "<a href=\"gdlookup://localhost/日本語\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/%E6%97%A5%E6%9C%AC%E8%AA%9E\">x</a>",
      "twice": true
    },
    {
      "id": "markup-cleanup-in-headword",
      "input": "<a href=\"gdlookup://localhost/red<b>fox</b>\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/red%20fox\">x</a>",
      "twice": true
    },
    {
      "id": "collapsed-whitespace-in-headword",
      "input": "<a href=\"gdlookup://localhost/red   \n fox\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/red%20fox\">x</a>",
      "twice": true
    },
    {
      "id": "single-quoted-href",
      "input": "<a href='gdlookup://localhost/red fox'>x</a>",
      "expected": "<a href='gdlookup://localhost/red%20fox'>x</a>",
      "twice": true
    },
    {
      "id": "plus-is-literal-and-encoded",
      "input": "<a href=\"gdlookup://localhost/red+fox\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/red%2Bfox\">x</a>",
      "twice": true
    },
    {
      "id": "scheme-and-host-case-normalized",
      "input": "<A HREF=\"GDLOOKUP://LOCALHOST/red fox\">x</A>",
      "expected": "<A HREF=\"gdlookup://localhost/red%20fox\">x</A>",
      "twice": true
    },
    {
      "id": "fragment-only-kept-verbatim",
      "input": "<a href=\"gdlookup://localhost/cat#sec 1\">x</a>",
      "expected": "<a href=\"gdlookup://localhost/cat#sec 1\">x</a>",
      "twice": true
    },
    {
      "id": "no-headword-left-alone",
      "input": "<a href=\"gdlookup://localhost\">x</a>",
      "expected": "<a href=\"gdlookup://localhost\">x</a>",
      "twice": true
    },
    {
      "id": "query-without-path-left-alone",
      "input": "<a href=\"gdlookup://localhost?blank=1\">x</a>",
      "expected": "<a href=\"gdlookup://localhost?blank=1\">x</a>",
      "twice": true
    },
    {
      "id": "foreign-scheme-untouched",
      "input": "<a href=\"http://localhost/red fox\">x</a>",
      "expected": "<a href=\"http://localhost/red fox\">x</a>",
      "twice": true
    },
    {
      "id": "relative-anchor-link-untouched",
      "input": "<a href=\"cat#part\">x</a>",
      "expected": "<a href=\"cat#part\">x</a>",
      "twice": true
    },
    {
      "id": "bword-link-untouched",
      "input": "<a href=\"bword:cat\">x</a>",
      "expected": "<a href=\"bword:cat\">x</a>",
      "twice": true
    },
    {
      "id": "non-href-attribute-untouched",
      "input": "<a title=\"gdlookup://localhost/red fox\" href=\"cat\">x</a>",
      "expected": "<a title=\"gdlookup://localhost/red fox\" href=\"cat\">x</a>",
      "twice": true
    },
    {
      "id": "link-element-href-untouched",
      "input": "<link href=\"gdlookup://localhost/red fox\">",
      "expected": "<link href=\"gdlookup://localhost/red fox\">",
      "twice": true
    },
    {
      "id": "two-links-one-string",
      "input": "<a href=\"gdlookup://localhost/red fox\">a</a> <a href=\"gdlookup://localhost/cat\">b</a>",
      "expected": "<a href=\"gdlookup://localhost/red%20fox\">a</a> <a href=\"gdlookup://localhost/cat\">b</a>",
      "twice": true
    }
  ],

