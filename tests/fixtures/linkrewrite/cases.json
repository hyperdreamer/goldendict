      "input": "<img src='  ../img.png  '><style>.x{content:'</stylesheet>';background:url(bg.png)}</style>",
      "expected": "<img src='  https://example.test/img.png  '><style>.x{content:'</stylesheet>';background:url(https://example.test/dir/bg.png)}</style>",
