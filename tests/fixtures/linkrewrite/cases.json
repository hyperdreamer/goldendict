      "input": "url( bg.png )<div title=\"url(untouched.png)\" style=\"background:url( icon.png )\"></div><!-- url(comment.png) --><script>url(script.png)</script><textarea>url(text.png)<img src=ignored.png></textarea><title>url(title.png)</title>",
      "expected": "url( https://example.test/dir/bg.png )<div title=\"url(untouched.png)\" style=\"background:url( https://example.test/dir/icon.png )\"></div><!-- url(comment.png) --><script>url(script.png)</script><textarea>url(text.png)<img src=ignored.png></textarea><title>url(title.png)</title>",
      "twice": true
    },
    {
      "id": "url-padding-and-stylesheet-end-boundary",
