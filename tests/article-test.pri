# Shared production closure for the Browser/Article test targets.
#
# A suite includes this file *after* tests/support.pri and names only what is
# specific to it:
#
#     TARGET = tst_article_load
#     include(../testsupport.pri)
#     GD_ARTICLE_EXTRA_SOURCES = $$PWD/some_production_helper.cc
#     GD_ARTICLE_EXTRA_HEADERS = $$PWD/some_production_helper.hh
#     GD_ARTICLE_EXTRA_FORMS   = $$GD_REPO_ROOT/some_dialog.ui
#     include(../article-test.pri)
#
# What it supplies:
#   * the Qt feature modules an Article target needs (xml/sql/svg/help plus
#     printsupport and the engine/profile stack),
#   * the article production closure -- URL parsing, maker, network manager,
#     scheme handler and the dictionary utilities those need,
#   * MOC/UI handling for the suite's own headers and forms,
#   * the shipped article resources (style sheets, icons, flags) as a qrc built
#     into the ignored output directory,
#   * the test-only dictionary fixture (support/dictionary_stub.cc), which needs
#     the production reader from articleschemes.cc.
#
# What it never does: add main.cc or MainWindow. A suite that needs a utility
# reaches it through the module that owns it, never by compiling the
# application's entry point.

QT += core gui widgets xml sql svg help printsupport network \
      webenginecore webenginewidgets webchannel

GD_ARTICLE_CLOSURE_SOURCES = \
    articleurls.cc \
    article_maker.cc \
    article_netmgr.cc \
    articleschemes.cc \
    config.cc \
    dictionary.cc \
    folding.cc \
    fsencoding.cc \
    gddebug.cc \
    htmlescape.cc \
    instances.cc \
    langcoder.cc \
    mutex.cc \
    utf8.cc \
    wildcard.cc \
    wordfinder.cc \
    wstring.cc \
    wstring_qt.cc

GD_ARTICLE_CLOSURE_HEADERS = \
    articleurls.hh \
    article_maker.hh \
    article_netmgr.hh \
    articleschemes.hh \
    dictionary.hh \
    folding.hh \
    fsencoding.hh \
    gddebug.hh \
    htmlescape.hh \
    instances.hh \
    langcoder.hh \
    wildcard.hh \
    wordfinder.hh

for(GD_ARTICLE_ENTRY, GD_ARTICLE_CLOSURE_SOURCES) {
    SOURCES += $$GD_REPO_ROOT/$$GD_ARTICLE_ENTRY
}

for(GD_ARTICLE_ENTRY, GD_ARTICLE_CLOSURE_HEADERS) {
    HEADERS += $$GD_REPO_ROOT/$$GD_ARTICLE_ENTRY
}

# The test-only dictionary fixture: FixtureDictionary, ControlledDataRequest and
# the injected reader factory. It links the production reader above, which is why
# it cannot live in the shared support glob.
SOURCES += $$GD_TESTS_ROOT/support/dictionary_stub.cc

# Per-suite additions (production sources its target owns).
SOURCES += $$GD_ARTICLE_EXTRA_SOURCES
HEADERS += $$GD_ARTICLE_EXTRA_HEADERS
FORMS += $$GD_ARTICLE_EXTRA_FORMS

# Bundle the actual shipped article assets. The application-wide qrc also
# requires version.txt generated by the unconverted root project; build this
# equivalent article subset in the ignored output directory instead.
GD_ARTICLE_RESOURCE_DIR = $$OUT_PWD/build/tests/$$TARGET/rcc
mkpath($$GD_ARTICLE_RESOURCE_DIR)
GD_ARTICLE_QRC = $$GD_ARTICLE_RESOURCE_DIR/article-resources.qrc
GD_ARTICLE_RESOURCE_XML = <RCC> <qresource>
GD_ARTICLE_ASSETS = $$files($$GD_REPO_ROOT/article-style*.css) \
                    $$files($$GD_REPO_ROOT/icons/*.png) \
                    $$files($$GD_REPO_ROOT/flags/*.png)
for(GD_ARTICLE_ASSET, GD_ARTICLE_ASSETS) {
    GD_ARTICLE_ALIAS = $$relative_path($$GD_ARTICLE_ASSET, $$GD_REPO_ROOT)
    GD_ARTICLE_RESOURCE_XML += <file alias=\"$$GD_ARTICLE_ALIAS\">$$GD_ARTICLE_ASSET</file>
}
GD_ARTICLE_RESOURCE_XML += </qresource> </RCC>
write_file($$GD_ARTICLE_QRC, GD_ARTICLE_RESOURCE_XML)
RESOURCES += $$GD_ARTICLE_QRC

# dictionary.cc still carries the not-yet-converted ZipFile index timestamp path.
# Compiling with per-function sections and dropping the unreached sections keeps
# a suite that only needs the dictionary data getters linkable without dragging
# in the whole ZipFile implementation.
unix {
    QMAKE_CXXFLAGS += -ffunction-sections -fdata-sections
    QMAKE_LFLAGS += -Wl,--gc-sections
}
