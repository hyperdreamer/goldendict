tests/tst_*/tst_encoding
tests/tst_*/tst_htmlescape
tests/tst_*/tst_hotkeys
tests/tst_*/tst_langcoder
tests/tst_*/tst_linkrewrite
tests/tst_*/tst_platformwindow
tests/tst_*/tst_regex
