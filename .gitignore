# Test build outputs (the suites compile in place). Only the BUILT binaries are
# ignored: `tests/tst_*/tst_[a-z_]*` also matched tracked sources such as
# tst_hotkeys.cc and tst_platformwindow.pro, which silently kept new suites out
# of commits unless they were force-added.
tests/**/.qmake.stash
tests/**/target_wrapper.sh
tests/tst_*/tst_article_schemes
tests/tst_*/tst_article_stream
tests/tst_*/tst_portal_hotkeys
tests/tst_*/tst_save_article
ests/tst_*/tst_print_pipeline
tests/tst_*/tst_article_history
tests/tst_*/tst_external_content
tests/tst_*/tst_website_frames
tests/tst_*/tst_hotkeys_noffmpeg
